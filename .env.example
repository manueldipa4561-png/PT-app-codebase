# Leave both empty to run the demo: the whole backend runs in the browser.
# Set both to go live on your Supabase project (EU region).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional. <slug>.<this domain> opens the trainer with that slug, e.g. marco-bellini.app.example.it
VITE_APP_BASE_DOMAIN=

# Store builds only (Capacitor): bake one trainer into the binary, since it has no hostname.
VITE_TRAINER=

# Netlify edge function (server side, set in the Netlify UI, not prefixed with VITE_).
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Same as VITE_APP_BASE_DOMAIN, read by the edge function.
APP_BASE_DOMAIN=
